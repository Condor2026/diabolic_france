# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version
pyvenv.cfg

# -----------------------------------------------------------------------------
# Packaging / distribution
# -----------------------------------------------------------------------------
*.whl
*.tar.gz
*.zip
*.rar
*.7z

# -----------------------------------------------------------------------------
# Données locales générées par DIABOLIC FRANCE
# (ne jamais versionner : contient les événements scrapés, l'état des sources,
#  le cache d'URL et les journaux)
# -----------------------------------------------------------------------------
diabolic_france.json
diabolic_france_backup.json
diabolic_france.json.tmp
diabolic_france.log
diabolic_france.log.*
url_cache_crime.json
url_cache_crime.json.tmp
estado_fuentes_crime.json
estado_fuentes_crime.json.tmp

# Exports générés (JSON / CSV / HTML / GeoJSON)
diabolic_export.*
diabolic_france_export.*
diabolic_france_report.html
exports/
export/
*.geojson

# Graphiques statiques générés
graficos_estaticos/
graficos_estaticos/**
*.png
!Diabolic_France_Logo.png

# -----------------------------------------------------------------------------
# Journaux / logs
# -----------------------------------------------------------------------------
*.log
*.log.*
logs/
log/

# -----------------------------------------------------------------------------
# Fichiers de configuration locaux
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
config.local.*
settings.local.*

# -----------------------------------------------------------------------------
# Bases de données locales (si SQLite / DuckDB ajoutés plus tard)
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.duckdb

# -----------------------------------------------------------------------------
# IDE / éditeurs
# -----------------------------------------------------------------------------
.vscode/
.vscode/**
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
.idea/**
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

